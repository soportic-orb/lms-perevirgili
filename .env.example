# Campus PSPV — configuració de l'entorn. Copia'l a .env; no pugis mai .env al repositori.
# config/config.php llegeix primer les variables d'entorn reals i després aquest fitxer.

# local | staging | production
APP_ENV=local
MOODLE_WWWROOT=http://localhost:8080
# Fora de l'arrel web. A CloudPanel: /home/<usuari>/moodledata
MOODLE_DATAROOT=/var/www/moodledata
# Contrasenya inicial de l'administrador (només la fa servir `make install`).
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=
MOODLE_ADMIN_EMAIL=admin@example.com

# Base de dades. CloudPanel ofereix MySQL o MariaDB; Moodle 5.3 exigeix MariaDB >= 11.4 o MySQL >= 8.4.
# DB_TYPE: mariadb | mysqli | pgsql
DB_TYPE=mariadb
DB_HOST=db
DB_PORT=3306
DB_NAME=moodle
DB_USER=moodle
DB_PASS=
DB_PREFIX=mdl_

# Redis (sessions i memòria cau MUC). Deixa REDIS_HOST buit per no fer-lo servir.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefix propi de cada web si el Redis és compartit (staging i producció al mateix servidor).
REDIS_PREFIX=pspv_

# Correu sortint. En local, Mailpit (http://localhost:8025). Buit = configuració de l'administració de Moodle.
SMTP_HOST=mailpit:1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
NOREPLY_ADDRESS=noreply@example.com

# Inici de sessió amb Google i Microsoft (docs/ACCES.md). Sense credencials, el proveïdor no es crea.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# Tenant de Microsoft Entra ID de l'hospital (identificador o domini verificat). TODO: el dona l'hospital.
OAUTH_MICROSOFT_TENANT=

# Actualitzacions OTA dels plugins propis (docs/OTA.md).
OTA_REPOSITORY=soportic-orb/lms-perevirgili
# Clau pública Ed25519 (base64) que imprimeix scripts/ota-keygen.sh. Sense clau no s'aplica cap actualització.
OTA_PUBLIC_KEY=
# Només si el repositori passa a ser privat: token fine-grained amb permís de lectura de Contents.
OTA_GITHUB_TOKEN=

# Còpies de seguretat (deploy/cloudpanel/backup.sh, docs/COPIES.md).
# Carpeta on es guarden, fora de la carpeta pública del lloc. Buit = no es fan ni es vigilen.
BACKUP_DIR=
# Dies que es conserven les còpies diàries.
BACKUP_KEEP_DAYS=14

# Monitoratge (docs/MONITORATGE.md). Token de /local/pspvcore/health.php per a un monitor extern.
# Genera'l amb: openssl rand -hex 32. Buit = la pàgina no existeix.
HEALTH_TOKEN=

# Tests (només local i CI).
PHPUNIT_DATAROOT=/var/www/phpunitdata
BEHAT_WWWROOT=http://web
BEHAT_DATAROOT=/var/www/behatdata
