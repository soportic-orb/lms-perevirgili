{{!
    @template local_pspvaccess/audit

    Audit log of the workers cohort.

    Example context (json):
    {
        "hasentries": true,
        "entries": [
            {
                "time": "11/11/26, 12:00",
                "fullname": "Maria Puig",
                "email": "maria@example.com",
                "action": "Added",
                "added": true,
                "reason": "Corporate email domain",
                "origin": "Login"
            }
        ]
    }
}}
<div class="local-pspvaccess-audit">
    <p>{{#str}}audit_intro, local_pspvaccess{{/str}}</p>
    {{^hasentries}}
    <p data-region="audit-empty">{{#str}}audit_empty, local_pspvaccess{{/str}}</p>
    {{/hasentries}}
    {{#hasentries}}
    <table class="table table-sm generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}date{{/str}}</th>
                <th scope="col">{{#str}}user{{/str}}</th>
                <th scope="col">{{#str}}action{{/str}}</th>
                <th scope="col">{{#str}}audit_reason, local_pspvaccess{{/str}}</th>
                <th scope="col">{{#str}}audit_origin, local_pspvaccess{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#entries}}
            <tr>
                <td>{{time}}</td>
                <td>{{fullname}}<br><span class="text-muted small">{{email}}</span></td>
                <td>
                    <span class="badge {{#added}}text-bg-success{{/added}}{{^added}}text-bg-secondary{{/added}}">{{action}}</span>
                </td>
                <td>{{reason}}</td>
                <td>{{origin}}</td>
            </tr>
            {{/entries}}
        </tbody>
    </table>
    {{/hasentries}}
</div>
