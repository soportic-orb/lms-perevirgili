{{!
    @template local_pspvaccess/employees_status

    Status of the employee list, above the import form.

    Example context (json):
    {
        "count": 1250,
        "imported": "11/11/26, 12:00",
        "listenabled": false,
        "norules": false,
        "settingsurl": "https://example.com/admin/settings.php?section=local_pspvaccess_settings",
        "resyncurl": "https://example.com/local/pspvaccess/employees.php?resync=1&sesskey=abc"
    }
}}
<div class="local-pspvaccess-employees mb-4">
    <p>{{#str}}employees_intro, local_pspvaccess{{/str}}</p>
    {{#norules}}
    <div class="alert alert-warning" role="alert">
        {{#str}}settings_norules, local_pspvaccess{{/str}}
        <a href="{{settingsurl}}">{{#str}}settings_title, local_pspvaccess{{/str}}</a>
    </div>
    {{/norules}}
    {{^norules}}{{^listenabled}}
    <div class="alert alert-info" role="alert">
        {{#str}}employees_listdisabled, local_pspvaccess{{/str}}
        <a href="{{settingsurl}}">{{#str}}settings_title, local_pspvaccess{{/str}}</a>
    </div>
    {{/listenabled}}{{/norules}}
    <dl class="row">
        <dt class="col-sm-3">{{#str}}employees_count, local_pspvaccess{{/str}}</dt>
        <dd class="col-sm-9" data-region="employee-count">{{count}}</dd>
        <dt class="col-sm-3">{{#str}}employees_lastimport, local_pspvaccess{{/str}}</dt>
        <dd class="col-sm-9">{{imported}}</dd>
    </dl>
    <a class="btn btn-secondary" href="{{resyncurl}}">{{#str}}resync_now, local_pspvaccess{{/str}}</a>
</div>
