{{!
    @template local_pspvmailing/unsubscribe

    Page a user lands on from the unsubscribe link of an email.

    Example context (json):
    {
        "action": "https://example.com/local/pspvmailing/unsubscribe.php?u=5&t=abc",
        "optedout": false,
        "homeurl": "https://example.com/"
    }
}}
<div class="local-pspvmailing-unsubscribe" data-region="pspvmailing-unsubscribe">
    {{^optedout}}
    <p>{{#str}}unsubscribe_question, local_pspvmailing{{/str}}</p>
    <form method="post" action="{{action}}">
        <button type="submit" class="btn btn-primary">{{#str}}unsubscribe_confirm, local_pspvmailing{{/str}}</button>
        <a class="btn btn-secondary" href="{{homeurl}}">{{#str}}cancel{{/str}}</a>
    </form>
    {{/optedout}}
    {{#optedout}}
    <div class="alert alert-success" role="status">{{#str}}unsubscribe_done, local_pspvmailing{{/str}}</div>
    <form method="post" action="{{action}}">
        <input type="hidden" name="resubscribe" value="1">
        <p>{{#str}}unsubscribe_mistake, local_pspvmailing{{/str}}
            <button type="submit" class="btn btn-link p-0 align-baseline">{{#str}}unsubscribe_undo, local_pspvmailing{{/str}}</button></p>
    </form>
    {{/optedout}}
</div>
