{{!
    @template local_pspvshop/navbar_cart

    Link to the cart in the top bar.

    Example context (json):
    {
        "url": "https://example.com/local/pspvshop/cart.php",
        "count": 2
    }
}}
<a class="nav-link position-relative d-flex align-items-center px-2" href="{{url}}" data-region="pspvshop-navbar-cart">
    <i class="icon fa fa-cart-shopping me-0" aria-hidden="true"></i>
    <span class="visually-hidden">{{#str}}cart, local_pspvshop{{/str}}:</span>
    <span class="badge rounded-pill text-bg-primary ms-1">{{count}}</span>
</a>
