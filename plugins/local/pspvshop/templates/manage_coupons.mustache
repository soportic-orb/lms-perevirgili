{{!
    @template local_pspvshop/manage_coupons

    Discount codes.

    Example context (json):
    {
        "addurl": "https://example.com/local/pspvshop/manage/coupons.php?id=0",
        "hasrows": true,
        "rows": [
            {
                "code": "WELCOME10",
                "discount": "10 %",
                "product": "Any course",
                "until": "",
                "uses": "3 / 100",
                "enabled": true,
                "editurl": "https://example.com/local/pspvshop/manage/coupons.php?id=1",
                "deleteurl": "https://example.com/local/pspvshop/manage/coupons.php?delete=1"
            }
        ]
    }
}}
<div class="pspvshop-manage">
    <p><a class="btn btn-primary" href="{{addurl}}">{{#str}}coupon_add, local_pspvshop{{/str}}</a></p>
    {{^hasrows}}<p>{{#str}}coupons_none, local_pspvshop{{/str}}</p>{{/hasrows}}
    {{#hasrows}}
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}coupon_code, local_pspvshop{{/str}}</th>
                <th scope="col">{{#str}}total_discount, local_pspvshop{{/str}}</th>
                <th scope="col">{{#str}}coupon_product, local_pspvshop{{/str}}</th>
                <th scope="col">{{#str}}coupon_validuntil, local_pspvshop{{/str}}</th>
                <th scope="col">{{#str}}coupon_uses, local_pspvshop{{/str}}</th>
                <th scope="col">{{#str}}status{{/str}}</th>
                <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr>
                <td><code>{{code}}</code></td>
                <td>{{discount}}</td>
                <td>{{product}}</td>
                <td>{{until}}</td>
                <td>{{uses}}</td>
                <td>
                    {{#enabled}}<span class="badge text-bg-success">{{#str}}active{{/str}}</span>{{/enabled}}
                    {{^enabled}}<span class="badge text-bg-secondary">{{#str}}inactive{{/str}}</span>{{/enabled}}
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-secondary" href="{{editurl}}">{{#str}}edit{{/str}}<span class="visually-hidden">: {{code}}</span></a>
                    <a class="btn btn-sm btn-outline-danger" href="{{deleteurl}}">{{#str}}delete{{/str}}<span class="visually-hidden">: {{code}}</span></a>
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
    {{/hasrows}}
</div>
