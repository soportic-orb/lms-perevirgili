{{!
    @template local_pspvshop/catalogue

    Public catalogue of the courses on sale, with its filters.

    Example context (json):
    {
        "actionurl": "https://example.com/local/pspvshop/index.php",
        "q": "",
        "areas": [{"value": 3, "label": "Nursing", "selected": false}],
        "modes": [{"value": "online", "label": "Online", "selected": false}],
        "prices": [{"value": "upto50", "label": "Up to 50", "selected": false}],
        "starts": [{"value": "upcoming", "label": "Not started yet", "selected": false}],
        "hasfilters": false,
        "total": 1,
        "hascards": true,
        "cards": [
            {
                "url": "https://example.com/local/pspvshop/product.php?id=1",
                "name": "Chronic wound care",
                "category": "Nursing",
                "summary": "Assessment, prevention and treatment.",
                "hasimage": false,
                "image": "",
                "tone": 2,
                "hasmode": true,
                "mode": "Online",
                "hasstart": true,
                "start": "12 January 2027",
                "price": "€75.00",
                "isfree": false,
                "hasreduction": true,
                "generalprice": "€90.00",
                "haslimit": true,
                "seats": 12,
                "full": false
            }
        ]
    }
}}
<div class="pspvshop-catalogue">
    <form class="card mb-4" method="get" action="{{actionurl}}" role="search" aria-label="{{#str}}filters, local_pspvshop{{/str}}">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label" for="pspvshop-q">{{#str}}search, core{{/str}}</label>
                    <input type="search" class="form-control" id="pspvshop-q" name="q" value="{{q}}">
                </div>
                <div class="col-6 col-lg">
                    <label class="form-label" for="pspvshop-area">{{#str}}filter_area, local_pspvshop{{/str}}</label>
                    <select class="form-select" id="pspvshop-area" name="area">
                        <option value="0">{{#str}}filter_any, local_pspvshop{{/str}}</option>
                        {{#areas}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/areas}}
                    </select>
                </div>
                <div class="col-6 col-lg">
                    <label class="form-label" for="pspvshop-mode">{{#str}}filter_mode, local_pspvshop{{/str}}</label>
                    <select class="form-select" id="pspvshop-mode" name="mode">
                        <option value="">{{#str}}filter_any, local_pspvshop{{/str}}</option>
                        {{#modes}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/modes}}
                    </select>
                </div>
                <div class="col-6 col-lg">
                    <label class="form-label" for="pspvshop-price">{{#str}}filter_price, local_pspvshop{{/str}}</label>
                    <select class="form-select" id="pspvshop-price" name="price">
                        <option value="">{{#str}}filter_any, local_pspvshop{{/str}}</option>
                        {{#prices}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/prices}}
                    </select>
                </div>
                <div class="col-6 col-lg">
                    <label class="form-label" for="pspvshop-start">{{#str}}filter_start, local_pspvshop{{/str}}</label>
                    <select class="form-select" id="pspvshop-start" name="start">
                        <option value="">{{#str}}filter_any, local_pspvshop{{/str}}</option>
                        {{#starts}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/starts}}
                    </select>
                </div>
                <div class="col-12 col-lg-auto d-flex gap-2">
                    <button class="btn btn-primary flex-fill" type="submit">{{#str}}filter_apply, local_pspvshop{{/str}}</button>
                    {{#hasfilters}}<a class="btn btn-secondary" href="{{actionurl}}">{{#str}}filter_clear, local_pspvshop{{/str}}</a>{{/hasfilters}}
                </div>
            </div>
        </div>
    </form>

    <p class="text-muted" data-region="catalogue-total">{{#str}}catalogue_total, local_pspvshop, {{total}}{{/str}}</p>

    {{#hascards}}
    <div class="row g-3">
        {{#cards}}
                <div class="col-sm-6 col-lg-4">
                    <article class="card pspv-course h-100" data-region="product-card">
                        {{#hasimage}}
                        <div class="pspv-cover pspv-cover-image" style="background-image: url('{{image}}')" aria-hidden="true">
                            <span class="badge">{{category}}</span>
                        </div>
                        {{/hasimage}}
                        {{^hasimage}}
                        <div class="pspv-cover pspv-cover-tone-{{tone}}" aria-hidden="true">
                            <span class="badge">{{category}}</span>
                            <i class="ti ti-school"></i>
                        </div>
                        {{/hasimage}}
                        <div class="card-body d-flex flex-column">
                            <h3 class="pspv-course-title"><a class="stretched-link" href="{{url}}">{{{name}}}</a></h3>
                            <p class="pspv-course-summary">{{summary}}</p>
                            <div class="pspv-meta mb-3">
                                <span class="visually-hidden">{{category}}.</span>
                                {{#hasmode}}<span><i class="ti ti-device-laptop" aria-hidden="true"></i>{{mode}}</span>{{/hasmode}}
                                {{#hasstart}}<span><i class="ti ti-calendar-event" aria-hidden="true"></i>{{start}}</span>{{/hasstart}}
                            </div>
                            <div class="d-flex align-items-end justify-content-between mt-auto">
                                <div>
                                    {{#isfree}}<span class="pspvshop-price">{{#str}}price_free, local_pspvshop{{/str}}</span>{{/isfree}}
                                    {{^isfree}}<span class="pspvshop-price">{{price}}</span>{{/isfree}}
                                    {{#hasreduction}}<s class="pspvshop-price-old">{{generalprice}}</s>{{/hasreduction}}
                                </div>
                                {{#haslimit}}
                                <span class="pspvshop-seats">
                                    {{#full}}{{#str}}seats_none, local_pspvshop{{/str}}{{/full}}
                                    {{^full}}{{#str}}seats_left, local_pspvshop, {{seats}}{{/str}}{{/full}}
                                </span>
                                {{/haslimit}}
                            </div>
                        </div>
                    </article>
                </div>
        {{/cards}}
    </div>
    {{/hascards}}
    {{^hascards}}
    <div class="pspv-empty">
        <i class="ti ti-books" aria-hidden="true"></i>
        <p class="pspv-empty-title">{{#str}}catalogue_empty, local_pspvshop{{/str}}</p>
        <p class="pspv-empty-text">{{#str}}catalogue_empty_desc, local_pspvshop{{/str}}</p>
    </div>
    {{/hascards}}
</div>
