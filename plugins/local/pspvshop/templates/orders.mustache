{{!
    @template local_pspvshop/orders

    The purchases of the current user.

    Example context (json):
    {
        "hasorders": true,
        "orders": [{ "id": 12,
        "number": "2026-00012",
        "date": "11/11/26, 12:00",
        "status": {"label": "Paid", "colour": "success"},
        "ispending": false,
        "ispaid": true,
        "lines": [
            {
                "name": "Chronic wound care",
                "unitprice": "€75.00",
                "hasdiscount": false,
                "discount": "€0.00",
                "total": "€75.00",
                "courseurl": "https://example.com/course/view.php?id=2"
            }
        ],
        "hasdiscount": false,
        "discount": "€0.00",
        "couponcode": "",
        "hastax": false,
        "tax": "€0.00",
        "total": "€75.00",
        "url": "https://example.com/local/pspvshop/orders.php?id=12",
        "haslinks": true,
        "links": [{"url": "https://example.com/invoice.php?id=1", "text": "Invoice F-2026-0001"}] }],
        "catalogueurl": "https://example.com/local/pspvshop/index.php"
    }
}}
<div class="pspvshop-orders">
    {{^hasorders}}
    <div class="pspv-empty">
        <i class="ti ti-shopping-cart" aria-hidden="true"></i>
        <p class="pspv-empty-title">{{#str}}orders_none, local_pspvshop{{/str}}</p>
        <p class="pspv-empty-text"><a href="{{catalogueurl}}">{{#str}}catalogue_back, local_pspvshop{{/str}}</a></p>
    </div>
    {{/hasorders}}
    {{#hasorders}}
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}order, local_pspvshop{{/str}}</th>
                        <th scope="col">{{#str}}date{{/str}}</th>
                        <th scope="col">{{#str}}courses{{/str}}</th>
                        <th scope="col">{{#str}}status{{/str}}</th>
                        <th scope="col" class="text-end">{{#str}}total, local_pspvshop{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#orders}}
                    <tr>
                        <td><a href="{{url}}">{{number}}</a></td>
                        <td class="text-nowrap">{{date}}</td>
                        <td>{{#lines}}<div>{{name}}</div>{{/lines}}</td>
                        <td><span class="badge text-bg-{{status.colour}}">{{status.label}}</span></td>
                        <td class="text-end text-nowrap">{{total}}</td>
                    </tr>
                    {{/orders}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasorders}}
</div>
