{{!
    @template local_pspvshop/cart

    Shopping cart with its totals and the discount code.

    Example context (json):
    {
        "actionurl": "https://example.com/local/pspvshop/cart.php",
        "sesskey": "abc",
        "haslines": true,
        "lines": [
            {
                "productid": 1,
                "name": "Chronic wound care",
                "url": "https://example.com/local/pspvshop/product.php?id=1",
                "unitprice": "€75.00",
                "hasdiscount": true,
                "discount": "€7.50",
                "total": "€67.50"
            }
        ],
        "hasdiscount": true,
        "discount": "€7.50",
        "hastax": false,
        "tax": "€0.00",
        "taxincluded": true,
        "total": "€67.50",
        "couponcode": "WELCOME10",
        "hascoupon": true,
        "couponinvalid": false,
        "checkouturl": "https://example.com/local/pspvshop/checkout.php",
        "catalogueurl": "https://example.com/local/pspvshop/index.php",
        "needslogin": false
    }
}}
<div class="pspvshop-cart">
    {{^haslines}}
    <div class="pspv-empty">
        <i class="ti ti-shopping-cart" aria-hidden="true"></i>
        <p class="pspv-empty-title">{{#str}}cart_empty, local_pspvshop{{/str}}</p>
        <p class="pspv-empty-text"><a href="{{catalogueurl}}">{{#str}}catalogue_back, local_pspvshop{{/str}}</a></p>
    </div>
    {{/haslines}}
    {{#haslines}}
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card">
                <ul class="list-group list-group-flush">
                    {{#lines}}
                    <li class="list-group-item d-flex align-items-center gap-3" data-region="cart-line">
                        <div class="flex-fill">
                            <a class="fw-semibold" href="{{url}}">{{{name}}}</a>
                            {{#hasdiscount}}
                            <div class="small text-muted">{{unitprice}} − {{discount}}</div>
                            {{/hasdiscount}}
                        </div>
                        <strong class="text-nowrap">{{total}}</strong>
                        <form method="post" action="{{actionurl}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="remove">
                            <input type="hidden" name="productid" value="{{productid}}">
                            <button type="submit" class="btn btn-sm btn-secondary">{{#str}}remove{{/str}}<span class="visually-hidden">: {{{name}}}</span></button>
                        </form>
                    </li>
                    {{/lines}}
                </ul>
            </div>
            <p class="mt-3"><a href="{{catalogueurl}}">{{#str}}catalogue_back, local_pspvshop{{/str}}</a></p>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="{{actionurl}}" class="mb-3">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="coupon">
                        <label class="form-label" for="pspvshop-code">{{#str}}coupon_have, local_pspvshop{{/str}}</label>
                        <div class="input-group">
                            <input type="text" class="form-control{{#couponinvalid}} is-invalid{{/couponinvalid}}" id="pspvshop-code" name="code"
                                value="{{couponcode}}" autocomplete="off"{{#couponinvalid}} aria-describedby="pspvshop-code-error"{{/couponinvalid}}>
                            <button type="submit" class="btn btn-secondary">{{#str}}coupon_apply, local_pspvshop{{/str}}</button>
                        </div>
                        {{#couponinvalid}}
                        <div class="text-danger small mt-1" id="pspvshop-code-error">{{#str}}coupon_invalid, local_pspvshop{{/str}}</div>
                        {{/couponinvalid}}
                    </form>
                    <dl class="pspvshop-totals">
                        {{#hasdiscount}}
                        <div><dt>{{#str}}total_discount, local_pspvshop{{/str}}{{#hascoupon}} ({{couponcode}}){{/hascoupon}}</dt><dd>− {{discount}}</dd></div>
                        {{/hasdiscount}}
                        {{#hastax}}
                        <div>
                            <dt>{{#taxincluded}}{{#str}}total_taxincluded, local_pspvshop{{/str}}{{/taxincluded}}{{^taxincluded}}{{#str}}total_tax, local_pspvshop{{/str}}{{/taxincluded}}</dt>
                            <dd>{{tax}}</dd>
                        </div>
                        {{/hastax}}
                        <div class="pspvshop-total"><dt>{{#str}}total, local_pspvshop{{/str}}</dt><dd data-region="cart-total">{{total}}</dd></div>
                    </dl>
                    <form method="post" action="{{checkouturl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <button type="submit" class="btn btn-primary btn-lg w-100">{{#str}}checkout_continue, local_pspvshop{{/str}}</button>
                    </form>
                    {{#needslogin}}<p class="text-muted small mt-2 mb-0">{{#str}}checkout_needslogin, local_pspvshop{{/str}}</p>{{/needslogin}}
                </div>
            </div>
        </div>
    </div>
    {{/haslines}}
</div>
