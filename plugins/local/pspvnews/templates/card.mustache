{{!
    @template local_pspvnews/card

    A news article as a card. Used on the news page and, by the theme, on the front page.

    Example context (json):
    {
        "url": "https://example.com/local/pspvnews/view.php?id=1",
        "title": "A new course on home care",
        "summary": "What the course covers and who it is for.",
        "date": "12 November 2026",
        "isodate": "2026-11-12",
        "hasimage": false,
        "image": "",
        "tone": 2
    }
}}
<article class="card pspv-course pspv-news-card h-100" data-region="news-card">
    {{#hasimage}}
    <div class="pspv-cover pspv-cover-image" style="background-image: url('{{image}}')" aria-hidden="true"></div>
    {{/hasimage}}
    {{^hasimage}}
    <div class="pspv-cover pspv-cover-tone-{{tone}}" aria-hidden="true"><i class="ti ti-news"></i></div>
    {{/hasimage}}
    <div class="card-body d-flex flex-column">
        <p class="pspv-news-date"><time datetime="{{isodate}}">{{date}}</time></p>
        <h3 class="pspv-course-title"><a class="stretched-link" href="{{url}}">{{{title}}}</a></h3>
        <p class="pspv-course-summary mb-0">{{summary}}</p>
    </div>
</article>
