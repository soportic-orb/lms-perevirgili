{{!
    @template local_pspvnews/list

    The news page: the published articles as cards.

    Example context (json):
    {
        "hascards": true,
        "cards": [
            {"url": "https://example.com/local/pspvnews/view.php?id=1", "title": "A new course on home care",
             "summary": "What the course covers.", "date": "12 November 2026", "isodate": "2026-11-12",
             "hasimage": false, "image": "", "tone": 2}
        ],
        "canmanage": true,
        "manageurl": "https://example.com/local/pspvnews/manage/index.php"
    }
}}
<div class="local-pspvnews" data-region="pspvnews-list">
    {{#canmanage}}<p class="text-end"><a class="btn btn-secondary btn-sm" href="{{manageurl}}">{{#str}}manage, local_pspvnews{{/str}}</a></p>{{/canmanage}}
    {{#hascards}}
    <div class="row g-3">
        {{#cards}}
        <div class="col-sm-6 col-lg-4">{{> local_pspvnews/card }}</div>
        {{/cards}}
    </div>
    {{/hascards}}
    {{^hascards}}<p class="text-muted">{{#str}}news_none, local_pspvnews{{/str}}</p>{{/hascards}}
</div>
