{{!
    @template local_pspvnews/article

    A news article.

    Example context (json):
    {
        "title": "A new course on home care",
        "date": "12 November 2026",
        "isodate": "2026-11-12",
        "hasimage": false,
        "image": "",
        "summary": "What the course covers.",
        "body": "<p>The text of the article.</p>",
        "draft": false,
        "listurl": "https://example.com/local/pspvnews/index.php",
        "canmanage": true,
        "editurl": "https://example.com/local/pspvnews/manage/edit.php?id=1"
    }
}}
<article class="local-pspvnews-article" data-region="pspvnews-article">
    {{#draft}}<div class="alert alert-warning" role="status">{{#str}}article_draft_notice, local_pspvnews{{/str}}</div>{{/draft}}
    <p class="pspv-news-date"><time datetime="{{isodate}}">{{date}}</time></p>
    <h2 class="local-pspvnews-title">{{{title}}}</h2>
    {{#hasimage}}<img class="local-pspvnews-cover" src="{{image}}" alt="">{{/hasimage}}
    <div class="local-pspvnews-body">{{{body}}}</div>
    <p class="mt-4">
        <a class="btn btn-secondary" href="{{listurl}}">{{#str}}news_all, local_pspvnews{{/str}}</a>
        {{#canmanage}}<a class="btn btn-secondary" href="{{editurl}}">{{#str}}edit{{/str}}</a>{{/canmanage}}
    </p>
</article>
