{{!
    @template local_pspvnews/manage

    Every article, with the actions to write, change and delete them.

    Example context (json):
    {
        "addurl": "https://example.com/local/pspvnews/manage/edit.php",
        "publicurl": "https://example.com/local/pspvnews/index.php",
        "hasarticles": true,
        "articles": [
            {"title": "A new course on home care", "viewurl": "https://example.com/", "editurl": "https://example.com/",
             "deleteurl": "https://example.com/", "date": "12/11/26, 09:00", "ispublic": true, "isscheduled": false,
             "isdraft": false}
        ]
    }
}}
<p>
    <a class="btn btn-primary" href="{{addurl}}">{{#str}}article_add, local_pspvnews{{/str}}</a>
    <a class="btn btn-secondary" href="{{publicurl}}">{{#str}}news_page, local_pspvnews{{/str}}</a>
</p>
{{#hasarticles}}
<div class="table-responsive">
    <table class="table generaltable" data-region="pspvnews-manage">
        <thead>
            <tr>
                <th scope="col">{{#str}}article_title, local_pspvnews{{/str}}</th>
                <th scope="col">{{#str}}article_date, local_pspvnews{{/str}}</th>
                <th scope="col">{{#str}}status{{/str}}</th>
                <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#articles}}
            <tr>
                <th scope="row"><a href="{{viewurl}}">{{{title}}}</a></th>
                <td>{{date}}</td>
                <td>
                    {{#ispublic}}<span class="badge text-bg-success">{{#str}}status_published, local_pspvnews{{/str}}</span>{{/ispublic}}
                    {{#isscheduled}}<span class="badge text-bg-info">{{#str}}status_scheduled, local_pspvnews{{/str}}</span>{{/isscheduled}}
                    {{#isdraft}}<span class="badge text-bg-secondary">{{#str}}status_draft, local_pspvnews{{/str}}</span>{{/isdraft}}
                </td>
                <td class="text-end">
                    <a href="{{editurl}}">{{#str}}edit{{/str}}<span class="visually-hidden">: {{{title}}}</span></a> ·
                    <a href="{{deleteurl}}">{{#str}}delete{{/str}}<span class="visually-hidden">: {{{title}}}</span></a>
                </td>
            </tr>
            {{/articles}}
        </tbody>
    </table>
</div>
{{/hasarticles}}
{{^hasarticles}}<p class="text-muted">{{#str}}news_none, local_pspvnews{{/str}}</p>{{/hasarticles}}
