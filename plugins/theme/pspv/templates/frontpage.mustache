{{!
    @template theme_pspv/frontpage

    Public front page: hero, the two entry points and the catalogue of external training.

    Example context (json):
    {
        "title": "Training to care better for older people",
        "lead": "Accredited courses in geriatrics, rehabilitation and palliative care.",
        "searchurl": "https://example.com/course/search.php",
        "showdoors": true,
        "workerurl": "https://example.com/login/index.php",
        "externalurl": "https://example.com/login/signup.php",
        "dashboardurl": "https://example.com/my/",
        "catalogueurl": "https://example.com/course/index.php?categoryid=3",
        "hascourses": true,
        "courses": [
            {
                "url": "https://example.com/course/view.php?id=2",
                "name": "Comprehensive geriatric assessment in practice",
                "category": "Geriatrics",
                "summary": "A practical course.",
                "hasimage": false,
                "image": "",
                "tone": 1,
                "hasstart": true,
                "start": "12 January 2027",
                "hasprice": true,
                "price": "180,00 €"
            }
        ]
    }
}}
<div class="pspv-frontpage">
    <section class="pspv-hero" aria-labelledby="pspv-hero-title">
        <div class="pspv-container">
            <div class="row g-4 align-items-center">
                <div class="{{#showdoors}}col-lg-6{{/showdoors}}{{^showdoors}}col-lg-8{{/showdoors}}">
                    <h1 id="pspv-hero-title">{{title}}</h1>
                    <p class="pspv-hero-lead">{{lead}}</p>
                    <form class="pspv-hero-search" role="search" action="{{searchurl}}" method="get">
                        <label class="visually-hidden" for="pspv-search">{{#str}}searchcourses, theme_pspv{{/str}}</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="ti ti-search" aria-hidden="true"></i></span>
                            <input id="pspv-search" type="search" name="q" class="form-control"
                                placeholder="{{#str}}searchplaceholder, theme_pspv{{/str}}">
                            <button class="btn btn-primary" type="submit">{{#str}}search, core{{/str}}</button>
                        </div>
                    </form>
                </div>
                {{#showdoors}}
                <div class="col-lg-6">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <a class="pspv-door" href="{{workerurl}}" data-region="pspv-door-worker">
                                <span class="pspv-door-icon"><i class="ti ti-id-badge-2" aria-hidden="true"></i></span>
                                <span>
                                    <strong>{{#str}}door_worker, theme_pspv{{/str}}</strong>
                                    <span class="pspv-door-text">{{#str}}door_worker_desc, theme_pspv{{/str}}</span>
                                    <span class="pspv-door-action">{{#str}}door_worker_action, theme_pspv{{/str}}
                                        <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
                                </span>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a class="pspv-door" href="{{externalurl}}" data-region="pspv-door-external">
                                <span class="pspv-door-icon pspv-door-icon-secondary"><i class="ti ti-world" aria-hidden="true"></i></span>
                                <span>
                                    <strong>{{#str}}door_external, theme_pspv{{/str}}</strong>
                                    <span class="pspv-door-text">{{#str}}door_external_desc, theme_pspv{{/str}}</span>
                                    <span class="pspv-door-action">{{#str}}door_external_action, theme_pspv{{/str}}
                                        <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                {{/showdoors}}
                {{^showdoors}}
                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-primary btn-lg" href="{{dashboardurl}}">
                        <i class="ti ti-layout-dashboard me-1" aria-hidden="true"></i>{{#str}}gotodashboard, theme_pspv{{/str}}
                    </a>
                </div>
                {{/showdoors}}
            </div>
        </div>
    </section>

    <section class="pspv-catalogue" id="pspv-catalogue" aria-labelledby="pspv-catalogue-title">
        <div class="pspv-container">
            <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
                <h2 id="pspv-catalogue-title" class="mb-0">{{#str}}catalogue_title, theme_pspv{{/str}}</h2>
                {{#hascourses}}<a href="{{catalogueurl}}">{{#str}}catalogue_all, theme_pspv{{/str}}
                    <i class="ti ti-arrow-right" aria-hidden="true"></i></a>{{/hascourses}}
            </div>
            {{#hascourses}}
            <div class="row g-3">
                {{#courses}}
                <div class="col-sm-6 col-lg-4">
                    <article class="card pspv-course h-100">
                        {{#hasimage}}
                        <div class="pspv-cover pspv-cover-image" style="background-image: url('{{image}}')" aria-hidden="true">
                            <span class="badge">{{category}}</span>
                        </div>
                        {{/hasimage}}
                        {{^hasimage}}
                        <div class="pspv-cover pspv-cover-tone-{{tone}}" aria-hidden="true">
                            <span class="badge">{{category}}</span>
                            <i class="ti ti-school"></i>
                        </div>
                        {{/hasimage}}
                        <div class="card-body d-flex flex-column">
                            <h3 class="pspv-course-title"><a class="stretched-link" href="{{url}}">{{{name}}}</a></h3>
                            <p class="pspv-course-summary">{{summary}}</p>
                            <div class="pspv-meta mt-auto">
                                <span class="visually-hidden">{{category}}.</span>
                                {{#hasstart}}<span><i class="ti ti-calendar-event" aria-hidden="true"></i>{{start}}</span>{{/hasstart}}
                                {{#hasprice}}<span class="pspv-price ms-auto">{{price}}</span>{{/hasprice}}
                            </div>
                        </div>
                    </article>
                </div>
                {{/courses}}
            </div>
            {{/hascourses}}
            {{^hascourses}}
            <div class="pspv-empty" data-region="pspv-catalogue-empty">
                <i class="ti ti-books" aria-hidden="true"></i>
                <p class="pspv-empty-title">{{#str}}catalogue_empty, theme_pspv{{/str}}</p>
                <p class="pspv-empty-text">{{#str}}catalogue_empty_desc, theme_pspv{{/str}}</p>
            </div>
            {{/hascourses}}
        </div>
    </section>
</div>
