{{!
    @template core/login_panel

    Left panel of the login page: the logo of the hospital and the message of the campus,
    or the instructions set in the authentication settings when there are any.

    Example context (json):
    {
        "output": {
            "pspv_logo_url": "https://example.com/logo.png",
            "pspv_logo_alt": "Parc Sanitari Pere Virgili",
            "pspv_hero_title": "Training to care better for older people",
            "pspv_hero_lead": "Accredited courses in geriatrics, rehabilitation and palliative care."
        },
        "leftinstructions": ""
    }
}}
<div class="login-layout-left-content pspv-login-panel">
    <img src="{{output.pspv_logo_url}}" class="pspv-brand-logo" alt="{{output.pspv_logo_alt}}">
    {{^leftinstructions}}
        <h1>{{output.pspv_hero_title}}</h1>
        <p>{{output.pspv_hero_lead}}</p>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="mt-4 text-start">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
